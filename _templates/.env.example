# 复制为软件目录内的 .env 后在本地填写；不得提交真实 .env。
# 只保留项目实际需要的变量，未使用的变量应删除。

APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO

# 外部服务（值留空，由运行环境注入）
EXTERNAL_API_KEY=

# 数据库
DATABASE_URL=

# OAuth（仅保留实际使用的提供商配置）
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=

# Session / 签名密钥
SESSION_SECRET=
